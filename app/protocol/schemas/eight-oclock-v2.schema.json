{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eight-oclock-v2.schema.json",
  "title": "Eight O'Clock Report Canonical Document v2",
  "type": "object",
  "required": ["format", "version", "uid", "generatedAt", "report", "tables"],
  "properties": {
    "format": {"const": "EIGHT-OCLOCK-REPORT"},
    "version": {"const": 2},
    "uid": {"type": "string", "minLength": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "report": {
      "type": "object",
      "required": ["uid", "title", "asOf"],
      "properties": {
        "uid": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "unitUid": {"type": "string"},
        "asOf": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["uid", "title", "columns", "rows"],
        "properties": {
          "uid": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "subtitle": {"type": "string"},
          "source": {"type": "object"},
          "columns": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["uid", "title", "type"],
              "properties": {
                "uid": {"type": "string", "minLength": 1},
                "title": {"type": "string", "minLength": 1},
                "type": {"enum": ["string", "number", "integer", "boolean", "date", "datetime", "enum", "array"]},
                "required": {"type": "boolean"},
                "unit": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["uid", "values"],
              "properties": {
                "uid": {"type": "string", "minLength": 1},
                "values": {"type": "object"}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    },
    "extensions": {"type": "object"}
  },
  "additionalProperties": true
}
